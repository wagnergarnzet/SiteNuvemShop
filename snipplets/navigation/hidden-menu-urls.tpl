{#
  Menu items to hide, by path (no domain, no leading/trailing slash).
  One entry per line inside the list. Keep this file in sync with the categories
  that are hidden/empty in the store (it can be regenerated by an automation).
#}
{% macro is_hidden(url) %}
{% set hidden_menu_paths = [
    'conjuntos',
    'macacoes-e-jardineiras',
    'blusas-e-camisetas/casaco',
    'kit-leve-3-pague-2',
    'mais-vendidos'
] %}
{% set menu_path = url | split('://') | last | split('/') | slice(1) | join('/') | trim('/') %}
{% if menu_path in hidden_menu_paths %}1{% endif %}
{% endmacro %}
